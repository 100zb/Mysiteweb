# Copy this file to .env and fill in real values.
# Never commit your actual .env file.

# PostgreSQL connection string (local Postgres, Docker, Neon, Supabase, etc.)
# Quick local option: `npx prisma dev` spins up a local Postgres for you.
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mysiteweb?schema=public"

# Auth.js — generate one with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Optional: enable "Sign in with GitHub" (leave unset to disable the button)
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Public site URL, used for metadata, sitemap and RSS feed generation
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
